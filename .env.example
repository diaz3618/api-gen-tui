# vk — Local Vault API Key Manager
# Copy this file to .env and fill in real values after running `vk vault-init`
# ⚠️  DO NOT commit .env to git — it contains Vault credentials

# Vault server address (where Docker exposes Vault)
VAULT_ADDR=http://127.0.0.1:8200

# Vault port (must match docker-compose.yml)
VAULT_PORT=8200

# Root token — written here by `vk vault-init` — DO NOT COMMIT
VAULT_ROOT_TOKEN=<your-root-token-after-vault-init>

# Unseal key — written here by `vk vault-init` — DO NOT COMMIT
VAULT_UNSEAL_KEY=<your-unseal-key-after-vault-init>

# KV v2 mount point (default: kv — matches vault-config.hcl)
VAULT_KV_MOUNT=kv

# Default path prefix for stored keys
VK_DEFAULT_PATH_PREFIX=api-keys

# Path to persisted Vault token (written by `vk login`)
VK_TOKEN_FILE=~/.vk/token
